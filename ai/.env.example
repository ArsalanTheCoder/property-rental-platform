# AI integration configuration for the Property Rental Platform.
# Copy to .env and fill in real values. Never commit .env.
#
# AI_MODE: "mock" (default, no key required) or "live" (requires AI_API_KEY).
# AI_BASE_URL: OpenAI-compatible Chat Completions endpoint. Leave empty for the provider default.

AI_MODE=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=
AI_MAX_TOKENS=
AI_MAX_TITLE_LENGTH=
AI_MAX_DESCRIPTION_LENGTH=
AI_MAX_QUESTION_LENGTH=
AI_MAX_ANSWER_LENGTH=
AI_CHAT_RATE_LIMIT=
AI_CHAT_RATE_WINDOW_MS=
