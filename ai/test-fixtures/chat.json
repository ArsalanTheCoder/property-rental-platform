{
  "meta": {
    "purpose": "Golden fixtures for the chatbot boundary used to support Backend-owner T031/T033. Inputs follow the spec §7.2 flow: a property context (shared README PropertyContext fields) plus a tenant question. expectedOutput is the EXACT deterministic result of createAiService({ AI_MODE: 'mock' }).answerQuestion(property, question). Chat is stateless: no conversation memory, no database writes. Backend owner: use these as expected bodies in supertest assertions for POST /api/ai/chat running in AI_MODE=mock."
  },
  "cases": [
    {
      "name": "price-question",
      "property": {
        "propertyId": "prop_123",
        "title": "Modern 2-Bed Apartment in DHA Karachi",
        "description": "A bright, furnished 2-bedroom apartment.",
        "propertyType": "apartment",
        "price": 50000,
        "location": "DHA Karachi",
        "bedrooms": 2,
        "bathrooms": 2,
        "amenities": ["parking", "wifi"],
        "furnished": true,
        "availability": true,
        "status": "published"
      },
      "question": "What is the monthly rent?",
      "expectedOutput": {
        "answer": "This property is listed at Rs. 50,000."
      }
    },
    {
      "name": "bedrooms-question",
      "property": {
        "propertyId": "prop_123",
